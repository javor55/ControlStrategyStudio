{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csd.studio/schema/project-1.json",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "format": {
      "type": "string"
    },
    "uid": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signal_categories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "color": {
            "type": "string"
          },
          "style": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "width": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 6
          },
          "description": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "title_block": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string"
        },
        "drawn": {
          "type": "string"
        },
        "checked": {
          "type": "string"
        },
        "approved": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
