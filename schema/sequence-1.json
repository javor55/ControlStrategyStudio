{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csd.studio/schema/sequence-1.json",
  "type": "object",
  "required": [
    "sequence"
  ],
  "properties": {
    "format": {
      "type": "string"
    },
    "uid": {
      "type": "string"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "scan": {
      "type": "string"
    },
    "sheets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "sheet": {
            "type": "integer",
            "minimum": 1
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "width": {
            "type": "number"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "always",
              "connected"
            ]
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "state_model": {
      "enum": [
        "isa88"
      ]
    },
    "sequencers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "priority": {
            "type": "integer"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "initial": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "sheet": {
            "type": "integer",
            "minimum": 1
          },
          "sequencer": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "time": {
            "type": "object",
            "properties": {
              "min": {
                "type": "string"
              },
              "max": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "actions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "required": [
                "q"
              ],
              "properties": {
                "q": {
                  "enum": [
                    "N",
                    "S",
                    "R",
                    "P1",
                    "P0",
                    "D",
                    "L"
                  ]
                },
                "set": {
                  "type": "string"
                },
                "value": {},
                "time": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false
            }
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "to": {
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "condition": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "comment": {
            "type": "string"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
