{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csd.studio/schema/blocktype-1.json",
  "type": "object",
  "required": [
    "type",
    "version"
  ],
  "properties": {
    "format": {
      "type": "string"
    },
    "uid": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "basic",
        "composite"
      ]
    },
    "inputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "always",
              "connected"
            ]
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "always",
              "connected"
            ]
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "params": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "default": {},
          "unit": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "enum": [
              "always",
              "connected"
            ]
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "diagram": {
      "type": "object",
      "properties": {
        "sheets": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string"
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false
          }
        },
        "blocks": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "doc": {
                "type": "string"
              },
              "comment": {
                "type": "string"
              },
              "scan": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "sheet": {
                "type": "integer",
                "minimum": 1
              },
              "params": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "display": {
                "type": "object",
                "properties": {
                  "params": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false
          }
        },
        "links": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "object"
            ],
            "if": {
              "type": "object"
            },
            "then": {
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                },
                "planned": {
                  "type": "boolean"
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false
            }
          }
        },
        "notes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "sheet": {
                "type": "integer",
                "minimum": 1
              },
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "width": {
                "type": "number"
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false
          }
        },
        "interface": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "in": {
              "type": "object",
              "properties": {
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            },
            "out": {
              "type": "object",
              "properties": {
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
