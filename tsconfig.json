{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": [
    "packages/*/src",
    "packages/*/test"
  ],
  "exclude": [
    "packages/export/src/pdf"
  ]
}
